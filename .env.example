# Copia este archivo como .env y llena tus datos reales.
# El archivo .env NUNCA se sube a GitHub ni se pone en el documento.

# Cloudflare D1
CF_ACCOUNT_ID=tu_account_id
CF_D1_DATABASE_ID=tu_database_id
CF_API_TOKEN=tu_token

# Firebase (ruta al archivo de la cuenta de servicio)
FIREBASE_KEY_PATH=./firebase-key.json
